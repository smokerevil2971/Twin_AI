# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=9607f5cf3db7c6594039be01e70bd1f73dacae4a2e4665fa5fb9024c950347f3
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=twinai
POSTGRES_PASSWORD=twinai_dev_password
POSTGRES_DB=twinai_db
DATABASE_URL=postgresql+asyncpg://twinai:twinai_dev_password@db:5432/twinai_db

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ─── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# LLM_PROVIDER=gemini   # set to "gemini" to use Gemini instead of OpenAI

# ─── Gupshup (WhatsApp Provider) ─────────────────────────────────────────────
# GUPSHUP_MODE=mock during dev (Meta approval can take up to 6 weeks).
# Switch to real once credentials are obtained.
GUPSHUP_MODE=mock
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_NAME=your-app-name
GUPSHUP_SENDER_NUMBER=+91XXXXXXXXXX
GUPSHUP_WEBHOOK_SECRET=your-hmac-webhook-secret

# ─── SendGrid (Owner email alerts) ───────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
ALERT_EMAIL_FROM=alerts@yourdomain.com
OWNER_ALERT_EMAIL=owner@yourdomain.com

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20
