# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=9607f5cf3db7c6594039be01e70bd1f73dacae4a2e4665fa5fb9024c950347f3
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=twinai
POSTGRES_PASSWORD=twinai_dev_password
POSTGRES_DB=twinai_db
DATABASE_URL=postgresql+asyncpg://twinai:twinai_dev_password@db:5432/twinai_db

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── AI Provider Switch ───────────────────────────────────────────────────────
# Set to "nim" to use NVIDIA NIM, or "gemini" to use Google Gemini
LLM_PROVIDER=nim

# ─── NVIDIA NIM (active when LLM_PROVIDER=nim) ────────────────────────────────
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_LLM_API_KEY=nvapi-your-llm-key-here
NIM_EMBED_API_KEY=nvapi-your-embed-key-here
NIM_MULTIMODAL_API_KEY=nvapi-your-multimodal-key-here
NIM_OCR_API_KEY=nvapi-your-ocr-key-here
NIM_RERANK_API_KEY=nvapi-your-rerank-key-here
# NIM model names (defaults — change only if using a different NIM model)
LLM_MODEL=meta/llama-4-maverick-17b-128e-instruct
EMBEDDING_MODEL=nvidia/llama-3_2-nemoretriever-300m-embed-v1
MULTIMODAL_MODEL=microsoft/phi-4-multimodal-instruct
RERANK_MODEL=nvidia/rerank-qa-mistral-4b

# ─── Gemini (active when LLM_PROVIDER=gemini) ─────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# When switching to Gemini, also set:
# LLM_MODEL=models/gemini-2.0-flash
# EMBEDDING_MODEL=models/gemini-embedding-001
# MULTIMODAL_MODEL=models/gemini-2.0-flash

# ─── Gupshup (WhatsApp Provider) ─────────────────────────────────────────────
# GUPSHUP_MODE=mock during dev (Meta approval can take up to 6 weeks).
# Switch to real once credentials are obtained.
GUPSHUP_MODE=mock
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_NAME=your-app-name
GUPSHUP_SENDER_NUMBER=+91XXXXXXXXXX
GUPSHUP_WEBHOOK_SECRET=your-hmac-webhook-secret

# ─── SendGrid (Owner email alerts) ───────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
ALERT_EMAIL_FROM=alerts@yourdomain.com
OWNER_ALERT_EMAIL=owner@yourdomain.com

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20
