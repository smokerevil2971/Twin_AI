{
  "info": {
    "_postman_id": "a1b2c3d4-0006-0006-0006-a1b2c3d40006",
    "name": "TwinAI Phase 3.1 Knowledge Base",
    "description": "Twin AI — Phase 3.1 Knowledge Base Ingestion Pipeline Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "twinai"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "doc_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.access_token) {",
              "  pm.collectionVariables.set('token', j.data.access_token);",
              "  console.log('Token saved');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@test.com\",\n  \"password\": \"password123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "description": "Login to get JWT. Auto-saves token."
      },
      "response": []
    },
    {
      "name": "2. Upload Text File (products)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.id) {",
              "  pm.collectionVariables.set('doc_id', j.data.id);",
              "  console.log('doc_id saved: ' + j.data.id);",
              "  console.log('Chunks indexed: ' + j.data.chunks_indexed);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "category", "type": "text", "value": "products" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/knowledge-base/upload",
          "host": ["{{base_url}}"],
          "path": ["knowledge-base", "upload"]
        },
        "description": "Upload test_kb.txt. Auto-saves doc_id. Expect status=indexed and chunks_indexed > 0."
      },
      "response": []
    },
    {
      "name": "3. Upload Offer File (with dates)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "category", "type": "text", "value": "offers" },
            { "key": "valid_from", "type": "text", "value": "2026-03-07T00:00:00" },
            { "key": "valid_until", "type": "text", "value": "2026-03-31T23:59:59" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/knowledge-base/upload",
          "host": ["{{base_url}}"],
          "path": ["knowledge-base", "upload"]
        },
        "description": "Upload a file as an offer with date range. Expect 200 with valid_from and valid_until in response."
      },
      "response": []
    },
    {
      "name": "4. Upload Offer - Missing Dates (expect 422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "category", "type": "text", "value": "offers" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/knowledge-base/upload",
          "host": ["{{base_url}}"],
          "path": ["knowledge-base", "upload"]
        },
        "description": "Offer without valid_from/valid_until. Should return 422."
      },
      "response": []
    },
    {
      "name": "5. Upload - Invalid Category (expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "category", "type": "text", "value": "invalid_cat" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/knowledge-base/upload",
          "host": ["{{base_url}}"],
          "path": ["knowledge-base", "upload"]
        },
        "description": "Invalid category. Should return 400."
      },
      "response": []
    },
    {
      "name": "6. List All Documents",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{base_url}}/knowledge-base",
          "host": ["{{base_url}}"],
          "path": ["knowledge-base"]
        },
        "description": "List all indexed documents for this tenant."
      },
      "response": []
    },
    {
      "name": "7. List Documents - Filter by category",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{base_url}}/knowledge-base?category=products",
          "host": ["{{base_url}}"],
          "path": ["knowledge-base"],
          "query": [{ "key": "category", "value": "products" }]
        },
        "description": "Filter to only product documents."
      },
      "response": []
    },
    {
      "name": "8. Delete Document",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{base_url}}/knowledge-base/{{doc_id}}",
          "host": ["{{base_url}}"],
          "path": ["knowledge-base", "{{doc_id}}"]
        },
        "description": "Delete the document uploaded in request 2. Removes from ChromaDB and sets is_active=false in Postgres."
      },
      "response": []
    },
    {
      "name": "9. Verify Delete - List Again",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{base_url}}/knowledge-base",
          "host": ["{{base_url}}"],
          "path": ["knowledge-base"]
        },
        "description": "Deleted document should show is_active=false in the list."
      },
      "response": []
    },
    {
      "name": "10. Delete Non-existent (expect 404)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{base_url}}/knowledge-base/00000000-0000-0000-0000-000000000000",
          "host": ["{{base_url}}"],
          "path": ["knowledge-base", "00000000-0000-0000-0000-000000000000"]
        },
        "description": "Should return 404 — document not found for this tenant."
      },
      "response": []
    }
  ]
}
