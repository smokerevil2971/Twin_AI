{
  "info": {
    "_postman_id": "a1b2c3d4-0004-0004-0004-a1b2c3d40004",
    "name": "TwinAI Phase 2.4 Celery Worker",
    "description": "Twin AI — Phase 2.4 Celery Broadcast Worker — tested indirectly by creating a broadcast and polling status changes (draft → sending → sent)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "twinai"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "broadcast_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.access_token) {",
              "  pm.collectionVariables.set('token', j.data.access_token);",
              "  console.log('Token saved');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@test.com\",\n  \"password\": \"password123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "description": "Login to get JWT. Auto-saves token."
      },
      "response": []
    },
    {
      "name": "2. Bulk Opt-in (worker prerequisite)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"confirmed\": true\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/clients/bulk-opt-in",
          "host": ["{{base_url}}"],
          "path": ["clients", "bulk-opt-in"]
        },
        "description": "Opt in all clients so Celery worker has eligible recipients to process."
      },
      "response": []
    },
    {
      "name": "3. Create Broadcast (triggers Celery task)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.id) {",
              "  pm.collectionVariables.set('broadcast_id', j.data.id);",
              "  console.log('broadcast_id saved: ' + j.data.id);",
              "  console.log('Eligible clients: ' + j.data.eligible_count);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Worker Test Broadcast\",\n  \"message_template\": \"Hi {{name}}, this is a Celery worker test!\",\n  \"channel\": \"whatsapp\",\n  \"language\": \"en\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/broadcasts",
          "host": ["{{base_url}}"],
          "path": ["broadcasts"]
        },
        "description": "Creates broadcast and immediately calls send_broadcast.delay(). Celery worker picks it up and processes recipients. Check status with requests below."
      },
      "response": []
    },
    {
      "name": "4. Poll Status - Immediately After Create",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/{{broadcast_id}}",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "{{broadcast_id}}"]
        },
        "description": "Run immediately after Create. Expect status=sending and some recipients still pending. Shows worker has started."
      },
      "response": []
    },
    {
      "name": "5. Poll Status - After 5 Seconds",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/{{broadcast_id}}",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "{{broadcast_id}}"]
        },
        "description": "Run 5 seconds after Create. Expect more recipients showing status=sent as Celery processes them at 80 msg/sec rate."
      },
      "response": []
    },
    {
      "name": "6. Poll Status - Final (expect sent)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/{{broadcast_id}}",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "{{broadcast_id}}"]
        },
        "description": "Run after all recipients processed. Expect status=sent, stats.pending=0, stats.sent=total. Confirms Celery task ran to completion."
      },
      "response": []
    },
    {
      "name": "7. Verify 24h Dedup - Create Same Broadcast Again (expect 422)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Duplicate Test\",\n  \"message_template\": \"Hi {{name}}, second message!\",\n  \"channel\": \"whatsapp\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/broadcasts",
          "host": ["{{base_url}}"],
          "path": ["broadcasts"]
        },
        "description": "Run immediately after request 6 completes. Should return 422 — all clients were messaged in last 24h so no eligible recipients. Confirms 24h dedup rule."
      },
      "response": []
    },
    {
      "name": "8. Export Final Report CSV",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/{{broadcast_id}}/export",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "{{broadcast_id}}", "export"]
        },
        "description": "Download final delivery report. All rows should show status=sent (mock adapter always succeeds). Confirms worker wrote correct status to DB."
      },
      "response": []
    }
  ]
}
