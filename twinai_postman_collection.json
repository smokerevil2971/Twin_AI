{
  "info": {
    "_postman_id": "twinai-phase12",
    "name": "Twin AI Phase 1.2",
    "description": "Twin AI Client Communication Agent — Phase 1.2 API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "twinai"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Check if the server is running. Expects 200 with server status."
      },
      "response": []
    },
    {
      "name": "2. Register Tenant",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.access_token) {",
              "  pm.collectionVariables.set('token', j.data.access_token);",
              "  console.log('Token saved from Register');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"business_name\": \"Test Shop\",\n  \"email\": \"owner4@test.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        },
        "description": "Register a new tenant. Auto-saves access_token to collection variable."
      },
      "response": []
    },
    {
      "name": "3. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.access_token) {",
              "  pm.collectionVariables.set('token', j.data.access_token);",
              "  console.log('Token saved from Login');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner4@test.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "description": "Login with registered credentials. Auto-saves access_token."
      },
      "response": []
    },
    {
      "name": "4. Login Wrong Password - expect 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner4@test.com\",\n  \"password\": \"wrongpass\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "description": "Should return 401 Unauthorized."
      },
      "response": []
    },
    {
      "name": "5. GET Clients (with token) - expect 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/clients",
          "host": ["{{base_url}}"],
          "path": ["clients"]
        },
        "description": "Fetch all clients for the authenticated tenant. Requires valid token."
      },
      "response": []
    },
    {
      "name": "6. GET Clients (no token) - expect 403",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/clients",
          "host": ["{{base_url}}"],
          "path": ["clients"]
        },
        "description": "Should return 403 Forbidden when no token is provided."
      },
      "response": []
    },
    {
      "name": "7. Validation Error (missing fields) - expect 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"incomplete@test.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        },
        "description": "Should return 422 Unprocessable Entity — missing business_name and password."
      },
      "response": []
    },
    {
      "name": "8. Duplicate Register - expect 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"business_name\": \"Test Shop\",\n  \"email\": \"owner4@test.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        },
        "description": "Should return 409 Conflict — email already registered."
      },
      "response": []
    },
    {
      "name": "9. Unknown Route - expect 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/nonexistent",
          "host": ["{{base_url}}"],
          "path": ["nonexistent"]
        },
        "description": "Should return 404 Not Found."
      },
      "response": []
    }
  ]
}
