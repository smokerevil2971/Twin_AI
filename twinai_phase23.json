{
  "info": {
    "_postman_id": "a1b2c3d4-0003-0003-0003-a1b2c3d40003",
    "name": "TwinAI Phase 2.3 SSE Stream",
    "description": "Twin AI — Phase 2.3 Real-Time Delivery Updates via Server-Sent Events",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "twinai"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "broadcast_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.access_token) {",
              "  pm.collectionVariables.set('token', j.data.access_token);",
              "  console.log('Token saved from Login');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@test.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "description": "Login to get JWT. Auto-saves access_token."
      },
      "response": []
    },
    {
      "name": "2. Create Broadcast (to get broadcast_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.id) {",
              "  pm.collectionVariables.set('broadcast_id', j.data.id);",
              "  console.log('broadcast_id saved: ' + j.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"SSE Test Broadcast\",\n  \"message_template\": \"Hi {{name}}, testing real-time updates!\",\n  \"channel\": \"whatsapp\",\n  \"language\": \"en\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/broadcasts",
          "host": ["{{base_url}}"],
          "path": ["broadcasts"]
        },
        "description": "Create a broadcast to get a broadcast_id for streaming. Auto-saves broadcast_id."
      },
      "response": []
    },
    {
      "name": "3. SSE Stream - Delivery Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "text/event-stream"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/{{broadcast_id}}/stream",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "{{broadcast_id}}", "stream"]
        },
        "description": "SSE stream — emits JSON events every 3s with current delivery counts. NOTE: Postman buffers SSE. Response only shows after broadcast completes. Use curl for real-time viewing (see description)."
      },
      "response": []
    },
    {
      "name": "4. SSE Stream - No Token (expect 403)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/{{broadcast_id}}/stream",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "{{broadcast_id}}", "stream"]
        },
        "description": "Should return 403 Forbidden — no token provided."
      },
      "response": []
    },
    {
      "name": "5. SSE Stream - Invalid Broadcast ID (expect 404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/00000000-0000-0000-0000-000000000000/stream",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "00000000-0000-0000-0000-000000000000", "stream"]
        },
        "description": "Should return 404 — broadcast does not exist or does not belong to this tenant."
      },
      "response": []
    },
    {
      "name": "6. Poll Broadcast Status (fallback to check progress)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/{{broadcast_id}}",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "{{broadcast_id}}"]
        },
        "description": "Regular GET detail — use this to manually poll status if SSE is not available. Shows stats.sent / stats.failed / stats.pending counts."
      },
      "response": []
    }
  ]
}
