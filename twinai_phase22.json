{
  "info": {
    "_postman_id": "a1b2c3d4-0002-0002-0002-a1b2c3d40002",
    "name": "TwinAI Phase 2.2 Broadcasts",
    "description": "Twin AI Client Communication Agent — Phase 2.2 Broadcast Creation & Sending API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "twinai"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "broadcast_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.access_token) {",
              "  pm.collectionVariables.set('token', j.data.access_token);",
              "  console.log('Token saved from Login');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@test.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "description": "Login to get JWT. Auto-saves access_token to collection variable."
      },
      "response": []
    },
    {
      "name": "2. Bulk Opt-in (prerequisite)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"confirmed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/clients/bulk-opt-in",
          "host": ["{{base_url}}"],
          "path": ["clients", "bulk-opt-in"]
        },
        "description": "Run this before creating a broadcast. Sets opted_in=true for all clients so they are eligible."
      },
      "response": []
    },
    {
      "name": "3. Create Broadcast",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "if (j.data && j.data.id) {",
              "  pm.collectionVariables.set('broadcast_id', j.data.id);",
              "  console.log('broadcast_id saved: ' + j.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Broadcast\",\n  \"message_template\": \"Hi {{name}}, check out our latest offer!\",\n  \"channel\": \"whatsapp\",\n  \"language\": \"en\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/broadcasts",
          "host": ["{{base_url}}"],
          "path": ["broadcasts"]
        },
        "description": "Creates a broadcast and immediately queues the Celery send task. Auto-saves broadcast_id."
      },
      "response": []
    },
    {
      "name": "4. Create Broadcast - Scheduled",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Scheduled Broadcast\",\n  \"message_template\": \"Hi {{name}}, our sale starts tomorrow!\",\n  \"channel\": \"whatsapp\",\n  \"language\": \"en\",\n  \"scheduled_at\": \"2026-03-08T09:00:00+05:30\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/broadcasts",
          "host": ["{{base_url}}"],
          "path": ["broadcasts"]
        },
        "description": "Creates a broadcast scheduled for a future time. Celery task is queued with eta."
      },
      "response": []
    },
    {
      "name": "5. Create Broadcast - No Eligible Clients (expect 422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Should Fail\",\n  \"message_template\": \"Hi {{name}}!\",\n  \"target_client_ids\": [\"00000000-0000-0000-0000-000000000000\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/broadcasts",
          "host": ["{{base_url}}"],
          "path": ["broadcasts"]
        },
        "description": "Should return 422 — no eligible opted-in clients found for the given target IDs."
      },
      "response": []
    },
    {
      "name": "6. List Broadcasts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts",
          "host": ["{{base_url}}"],
          "path": ["broadcasts"]
        },
        "description": "Paginated list of all broadcasts for this tenant. Shows status summary."
      },
      "response": []
    },
    {
      "name": "7. List Broadcasts - Page 2",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts?page=2&page_size=5",
          "host": ["{{base_url}}"],
          "path": ["broadcasts"],
          "query": [
            { "key": "page", "value": "2" },
            { "key": "page_size", "value": "5" }
          ]
        },
        "description": "Paginated list — page 2 with 5 results per page."
      },
      "response": []
    },
    {
      "name": "8. Get Broadcast Detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/{{broadcast_id}}",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "{{broadcast_id}}"]
        },
        "description": "Full detail with per-client delivery stats (pending/sent/delivered/read/failed counts)."
      },
      "response": []
    },
    {
      "name": "9. Export Broadcast CSV",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/{{broadcast_id}}/export",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "{{broadcast_id}}", "export"]
        },
        "description": "Downloads per-client delivery report as CSV. Response is a file download."
      },
      "response": []
    },
    {
      "name": "10. Get Broadcast - No Token (expect 403)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/broadcasts",
          "host": ["{{base_url}}"],
          "path": ["broadcasts"]
        },
        "description": "Should return 403 Forbidden when no token is provided."
      },
      "response": []
    },
    {
      "name": "11. Get Broadcast - Wrong Tenant (expect 404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/broadcasts/00000000-0000-0000-0000-000000000000",
          "host": ["{{base_url}}"],
          "path": ["broadcasts", "00000000-0000-0000-0000-000000000000"]
        },
        "description": "Should return 404 — broadcast ID does not belong to this tenant."
      },
      "response": []
    }
  ]
}
